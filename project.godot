; Engine configuration file.
; Godot 4.5

config_version=5

[application]

config/name="Project M²"
config/description="Platform-fighter roguelike metroidvania. Phase 1: fighter movement."
run/main_scene="res://scenes/test_room.tscn"
config/features=PackedStringArray("4.5")

[autoload]

InputSetup="*res://input/input_setup.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_jitter_fix=0.0
